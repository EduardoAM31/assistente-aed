POSTGRES_USER=rag
POSTGRES_PASSWORD=rag
POSTGRES_DB=aed
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
OLLAMA_URL=http://localhost:11434
OLLAMA_NUM_CTX=4096
LLM_PROVEDOR=ollama
LLM_MODEL=qwen2.5:3b
LLM_NUM_PREDICT=256
LLM_TEMPERATURE=0.1
# Generoso: a primeira chamada depois de um tempo parado carrega o modelo na GPU.
LLM_TIMEOUT=120
CHUNK_MAX_PALAVRAS=0
CHUNK_OVERLAP_PALAVRAS=0
EMBEDDING_MODELO=intfloat/multilingual-e5-small
# Configuração escolhida na etapa 11: e5-small, com cada seção num chunk só (0 = sem limite).
# O e5 exige os prefixos, entre aspas para o espaço no fim não se perder.
# Para o sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2, deixe os dois vazios.
EMBEDDING_PREFIXO_DOCUMENTO="passage: "
EMBEDDING_PREFIXO_PERGUNTA="query: "
EMBEDDING_DISPOSITIVO=cpu
BUSCA_K=3
