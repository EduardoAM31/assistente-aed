POSTGRES_USER=rag
POSTGRES_PASSWORD=rag
POSTGRES_DB=aed
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
OLLAMA_URL=http://localhost:11434
OLLAMA_NUM_CTX=4096
LLM_PROVEDOR=ollama
LLM_MODEL=qwen2.5:3b
LLM_NUM_PREDICT=256
LLM_TEMPERATURE=0.1
# Generoso: a primeira chamada depois de um tempo parado carrega o modelo na GPU.
LLM_TIMEOUT=120
CHUNK_MAX_PALAVRAS=60
CHUNK_OVERLAP_PALAVRAS=10
EMBEDDING_MODELO=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
# O MiniLM não usa prefixo. Para o intfloat/multilingual-e5-small, use
# EMBEDDING_PREFIXO_DOCUMENTO="passage: " e EMBEDDING_PREFIXO_PERGUNTA="query: "
# (com aspas, para o espaço no fim não se perder).
EMBEDDING_PREFIXO_DOCUMENTO=
EMBEDDING_PREFIXO_PERGUNTA=
EMBEDDING_DISPOSITIVO=cpu
BUSCA_K=3
